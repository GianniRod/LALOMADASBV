rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Quién puede ver y borrar los datos: solo estos usuarios del panel (/statsweb).
    // Los usuarios se crean a mano en Firebase Authentication (usuario@mail.com);
    // para sumar uno nuevo hay que agregarlo también a esta lista.
    // El sitio no lee nada: solo crea visitas y clicks, sin necesidad de login.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['gianni@mail.com', 'silvana@mail.com'];
    }

    // Ubicación aproximada (opcional): país, provincia, ciudad y coordenadas según la IP
    function validGeo(data) {
      return (!('country' in data) || (data.country is string && data.country.size() <= 2))
        && (!('region' in data) || (data.region is string && data.region.size() <= 60))
        && (!('city' in data) || (data.city is string && data.city.size() <= 60))
        && (!('lat' in data) || (data.lat is number && data.lat >= -90 && data.lat <= 90))
        && (!('lon' in data) || (data.lon is number && data.lon >= -180 && data.lon <= 180));
    }

    // El ID del documento es el SHA-256 de la IP del visitante.
    // Solo se permite CREAR: si la IP ya existe, el intento se
    // trata como "update" y se rechaza → 1 registro por IP.

    match /visits/{ipHash} {
      allow read: if isAdmin();
      allow create: if ipHash.matches('^[a-f0-9]{64}$')
        && request.resource.data.keys().hasOnly(['ts', 'day', 'referrer', 'country', 'region', 'city', 'lat', 'lon'])
        && request.resource.data.ts == request.time
        && request.resource.data.day is string
        && request.resource.data.day.size() == 10
        && request.resource.data.referrer is string
        && request.resource.data.referrer.size() <= 100
        && validGeo(request.resource.data);
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /clicks/{ipHash} {
      allow read: if isAdmin();
      allow create: if ipHash.matches('^[a-f0-9]{64}$')
        && request.resource.data.keys().hasOnly(['ts', 'day', 'button'])
        && request.resource.data.ts == request.time
        && request.resource.data.day is string
        && request.resource.data.day.size() == 10
        && request.resource.data.button is string
        && request.resource.data.button.size() <= 40;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Historial completo: un documento por acceso / por click (ID automático).
    // ipHash permite cruzar qué acceso terminó en click a WhatsApp.

    match /visitLog/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['ipHash', 'ts', 'day', 'referrer', 'country', 'region', 'city', 'lat', 'lon', 'utm'])
        && (!('utm' in request.resource.data) || (request.resource.data.utm is string && request.resource.data.utm.size() <= 200))
        && request.resource.data.ipHash is string
        && request.resource.data.ipHash.matches('^[a-f0-9]{64}$')
        && request.resource.data.ts == request.time
        && request.resource.data.day is string
        && request.resource.data.day.size() == 10
        && request.resource.data.referrer is string
        && request.resource.data.referrer.size() <= 100
        && validGeo(request.resource.data);
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /clickLog/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['ipHash', 'ts', 'day', 'button'])
        && request.resource.data.ipHash is string
        && request.resource.data.ipHash.matches('^[a-f0-9]{64}$')
        && request.resource.data.ts == request.time
        && request.resource.data.day is string
        && request.resource.data.day.size() == 10
        && request.resource.data.button is string
        && request.resource.data.button.size() <= 40;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
